# PowerShell scripts must keep CRLF line endings on every platform.
# Without this, Git can normalise them to LF on checkout and Windows PowerShell
# will still run the file, but diffs, hashes and signatures stop matching.
* text=auto
*.ps1   text eol=crlf
*.psd1  text eol=crlf
*.psm1  text eol=crlf

# Markdown and config keep LF.
*.md    text eol=lf
*.yml   text eol=lf

# Never touch these.
*.png   binary
*.jpg   binary
*.pdf   binary
